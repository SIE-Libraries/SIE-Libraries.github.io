<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Infographic: Axes of Symmetry in Cyclohexane</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Three.js & OrbitControls CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            chem: {
              dark: '#0B0F19',
              card: '#111827',
              border: '#1F2937',
              accent: '#38BDF8',
              carbon: '#334155',
              axial: '#EF4444',
              equatorial: '#10B981',
              c3: '#F59E0B',
              c2: '#8B5CF6',
              sigma: '#06B6D4',
              inversion: '#EC4899'
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #070B14;
      color: #E2E8F0;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }
    .glass-panel {
      background: rgba(17, 24, 39, 0.78);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glass-pill {
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(71, 85, 105, 0.8);
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #0ea5e9;
    }
    @keyframes pulse-subtle {
      0%, 100% { opacity: 0.9; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.02); }
    }
    .glow-amber {
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.25);
    }
    .glow-cyan {
      box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
    }
  </style>
</head>
<body class="min-h-screen text-slate-100 flex flex-col selection:bg-cyan-500/30 selection:text-cyan-200">

  <!-- Top Navigation / Infographic Banner -->
  <header class="border-b border-slate-800/80 bg-slate-950/70 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-cyan-500/20 font-bold text-white text-lg">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 20.66 7 20.66 17 12 22 3.34 17 3.34 7"></polygon>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </div>
        <div>
          <h1 class="text-lg sm:text-xl font-bold tracking-tight text-white flex items-center gap-2">
            Cyclohexane Symmetry <span class="text-xs px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-mono">D₃d Point Group</span>
          </h1>
          <p class="text-xs text-slate-400 hidden sm:block">Stereochemistry & Molecular Symmetry Infographic</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="#symmetry-matrix" class="text-xs text-slate-300 hover:text-cyan-400 transition-colors font-medium px-3 py-1.5 rounded-lg hover:bg-slate-800">
          Operation Matrix
        </a>
        <a href="#conformations-guide" class="text-xs text-slate-300 hover:text-cyan-400 transition-colors font-medium px-3 py-1.5 rounded-lg hover:bg-slate-800">
          Conformations
        </a>
        <button id="openGuideBtn" class="text-xs bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-3 py-1.5 rounded-lg transition-all shadow-md shadow-cyan-500/20 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Symmetry Guide
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-8">
    
    <!-- Top Hero Card: Interactive 3D Lab and Live Controls -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- 3D Canvas Container (8 Cols) -->
      <div class="lg:col-span-8 flex flex-col rounded-2xl glass-panel overflow-hidden border border-slate-800 relative shadow-2xl">
        <!-- Canvas Status Header -->
        <div class="p-3.5 border-b border-slate-800/80 bg-slate-900/60 flex flex-wrap items-center justify-between gap-2 z-10">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">Live 3D Molecule Visualizer</span>
            <span id="currentConformBadge" class="text-xs font-mono px-2 py-0.5 rounded bg-indigo-500/20 border border-indigo-500/30 text-indigo-300">
              Chair (D₃d)
            </span>
          </div>

          <!-- Camera Angle presets -->
          <div class="flex items-center gap-1 text-xs">
            <button id="btnViewPrincipal" title="Look straight down C3 axis" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors border border-slate-700/60">
              Top (Down C₃)
            </button>
            <button id="btnViewSide" title="Side view of the puckered ring" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors border border-slate-700/60">
              Side (Profile)
            </button>
            <button id="btnViewC2" title="View aligned along a C2 axis" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors border border-slate-700/60">
              Along C₂
            </button>
            <button id="btnResetView" title="Reset camera" class="p-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            </button>
          </div>
        </div>

        <!-- 3D Canvas element -->
        <div class="relative flex-1 w-full min-h-[460px] bg-gradient-to-b from-[#090D18] to-[#04060C] flex items-center justify-center">
          <canvas id="moleculeCanvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>

          <!-- Overlay On-screen Badge / Legend -->
          <div class="absolute bottom-4 left-4 pointer-events-none flex flex-col gap-1.5 text-[11px] font-mono text-slate-400 bg-slate-950/80 p-2.5 rounded-xl border border-slate-800 backdrop-blur-md">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-slate-500 inline-block"></span>
              <span>Carbon (C₁–C₆)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
              <span>Axial Hydrogen (Hₐ)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
              <span>Equatorial Hydrogen (Hₑ)</span>
            </div>
          </div>

          <!-- Active Operation Overlay Alert -->
          <div id="operationToast" class="absolute top-4 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-cyan-950/90 border border-cyan-500/40 text-cyan-300 text-xs font-mono shadow-xl opacity-0 pointer-events-none transition-opacity duration-300 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            <span id="operationToastText">Rotating 120° about C₃...</span>
          </div>

          <!-- Helper tip -->
          <div class="absolute top-4 right-4 pointer-events-none text-[10px] text-slate-500 bg-slate-900/60 px-2 py-1 rounded-md border border-slate-800/80 hidden sm:block">
            Drag to rotate • Scroll to zoom • Right-click to pan
          </div>
        </div>

        <!-- Animation / Operation Trigger Footer -->
        <div class="p-3.5 border-t border-slate-800/80 bg-slate-900/60 flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-slate-400 font-medium">Perform Operation:</span>
            <button id="btnOpC3" class="px-2.5 py-1.5 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 hover:bg-amber-500/30 transition-all font-mono font-medium flex items-center gap-1">
              ↺ C₃ (120°)
            </button>
            <button id="btnOpC2" class="px-2.5 py-1.5 rounded-lg bg-purple-500/20 text-purple-300 border border-purple-500/40 hover:bg-purple-500/30 transition-all font-mono font-medium flex items-center gap-1">
              ↻ C₂ (180°)
            </button>
            <button id="btnOpInversion" class="px-2.5 py-1.5 rounded-lg bg-pink-500/20 text-pink-300 border border-pink-500/40 hover:bg-pink-500/30 transition-all font-mono font-medium flex items-center gap-1">
              ∿ i (Inversion)
            </button>
            <button id="btnOpS6" class="px-2.5 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 hover:bg-cyan-500/30 transition-all font-mono font-medium flex items-center gap-1">
              ⚡ S₆ (60° + σₕ)
            </button>
          </div>

          <div class="flex items-center gap-2">
            <label class="flex items-center gap-1.5 cursor-pointer text-slate-300 hover:text-white">
              <input type="checkbox" id="checkAutoRotate" class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-0">
              <span>Auto-rotate</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Symmetry Controls & Interactive Inspector (4 Cols) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <!-- Conformation Switcher -->
        <div class="glass-panel p-4 rounded-2xl border border-slate-800 space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold tracking-wide text-white uppercase flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Conformation
            </h2>
            <span class="text-[11px] text-slate-400">Geometry Model</span>
          </div>

          <div class="grid grid-cols-2 gap-2 text-xs font-medium">
            <button id="confChair" class="p-2.5 rounded-xl border border-cyan-500/50 bg-cyan-500/10 text-cyan-300 flex flex-col items-start transition-all shadow-sm">
              <span class="font-bold">Chair</span>
              <span class="text-[10px] text-cyan-400/80 font-mono">D₃d • Min Energy</span>
            </button>
            <button id="confBoat" class="p-2.5 rounded-xl border border-slate-800 bg-slate-900/60 text-slate-400 hover:bg-slate-800 hover:text-white flex flex-col items-start transition-all">
              <span class="font-bold">Boat</span>
              <span class="text-[10px] text-slate-500 font-mono">C₂v • Flagpole steric</span>
            </button>
            <button id="confTwist" class="p-2.5 rounded-xl border border-slate-800 bg-slate-900/60 text-slate-400 hover:bg-slate-800 hover:text-white flex flex-col items-start transition-all">
              <span class="font-bold">Twist-Boat</span>
              <span class="text-[10px] text-slate-500 font-mono">D₂ • Chiral/Relaxes</span>
            </button>
            <button id="confPlanar" class="p-2.5 rounded-xl border border-slate-800 bg-slate-900/60 text-slate-400 hover:bg-slate-800 hover:text-white flex flex-col items-start transition-all">
              <span class="font-bold">Planar (Ref.)</span>
              <span class="text-[10px] text-slate-500 font-mono">D₆h • Eclipsed Strain</span>
            </button>
          </div>
        </div>

        <!-- Symmetry Element Visual Toggles -->
        <div class="glass-panel p-4 rounded-2xl border border-slate-800 space-y-3 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-sm font-semibold tracking-wide text-white uppercase flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-400"></span> Toggle Symmetry Elements
              </h2>
              <span class="text-[11px] text-slate-400">3D Overlays</span>
            </div>
            <p class="text-xs text-slate-400 mb-3">
              Enable visual 3D indicators for symmetry axes, planes, and the inversion point.
            </p>

            <div class="space-y-2 text-xs">
              <!-- C3 Axis Toggle -->
              <label class="flex items-center justify-between p-2 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 cursor-pointer transition-all">
                <div class="flex items-center gap-2.5">
                  <span class="w-3.5 h-3.5 rounded-md bg-amber-500 flex items-center justify-center text-slate-950 font-bold text-[9px]">3</span>
                  <div>
                    <span class="font-medium text-slate-200">Principal Axis (C₃)</span>
                    <p class="text-[10px] text-slate-400">Perpendicular to average plane (120°)</p>
                  </div>
                </div>
                <input type="checkbox" id="toggleC3" checked class="w-4 h-4 rounded text-amber-500 bg-slate-800 border-slate-700 focus:ring-0">
              </label>

              <!-- C2 Axes Toggle -->
              <label class="flex items-center justify-between p-2 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-purple-500/40 cursor-pointer transition-all">
                <div class="flex items-center gap-2.5">
                  <span class="w-3.5 h-3.5 rounded-md bg-purple-500 flex items-center justify-center text-white font-bold text-[9px]">2</span>
                  <div>
                    <span class="font-medium text-slate-200">3 × Dihedral Axes (C₂)</span>
                    <p class="text-[10px] text-slate-400">Pass through opposite C–C bond centers</p>
                  </div>
                </div>
                <input type="checkbox" id="toggleC2" checked class="w-4 h-4 rounded text-purple-500 bg-slate-800 border-slate-700 focus:ring-0">
              </label>

              <!-- Inversion Center Toggle -->
              <label class="flex items-center justify-between p-2 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-pink-500/40 cursor-pointer transition-all">
                <div class="flex items-center gap-2.5">
                  <span class="w-3.5 h-3.5 rounded-md bg-pink-500 flex items-center justify-center text-white font-bold text-[9px]">i</span>
                  <div>
                    <span class="font-medium text-slate-200">Inversion Center (i)</span>
                    <p class="text-[10px] text-slate-400">Geometric ring centroid (0,0,0)</p>
                  </div>
                </div>
                <input type="checkbox" id="toggleInversion" checked class="w-4 h-4 rounded text-pink-500 bg-slate-800 border-slate-700 focus:ring-0">
              </label>

              <!-- Dihedral Mirror Planes Toggle -->
              <label class="flex items-center justify-between p-2 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-cyan-500/40 cursor-pointer transition-all">
                <div class="flex items-center gap-2.5">
                  <span class="w-3.5 h-3.5 rounded-md bg-cyan-500 flex items-center justify-center text-slate-950 font-bold text-[9px]">σ</span>
                  <div>
                    <span class="font-medium text-slate-200">3 × Dihedral Planes (σd)</span>
                    <p class="text-[10px] text-slate-400">Contain opposite C atoms & axial H's</p>
                  </div>
                </div>
                <input type="checkbox" id="togglePlanes" class="w-4 h-4 rounded text-cyan-500 bg-slate-800 border-slate-700 focus:ring-0">
              </label>

              <!-- Hydrogen Color Mode Toggle -->
              <label class="flex items-center justify-between p-2 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/40 cursor-pointer transition-all">
                <div class="flex items-center gap-2.5">
                  <span class="w-3.5 h-3.5 rounded-md bg-emerald-500 flex items-center justify-center text-slate-950 font-bold text-[9px]">H</span>
                  <div>
                    <span class="font-medium text-slate-200">Axial / Equatorial Color Coding</span>
                    <p class="text-[10px] text-slate-400">Red = Axial, Green = Equatorial</p>
                  </div>
                </div>
                <input type="checkbox" id="toggleHColor" checked class="w-4 h-4 rounded text-emerald-500 bg-slate-800 border-slate-700 focus:ring-0">
              </label>
            </div>
          </div>

          <!-- Dynamic Info Box for current selection -->
          <div id="dynamicConformationNote" class="mt-2 p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 text-[11px] leading-relaxed text-slate-300">
            <strong class="text-cyan-400 block mb-0.5">Chair Conformation ($D_{3d}$):</strong>
            Possesses 1 principal $C_3$ axis, 3 perpendicular $C_2$ axes, an inversion center $i$, 2 improper rotations $S_6$, and 3 dihedral mirror planes $\sigma_d$. Total group order $h = 12$.
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">Group Theory Breakdown</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white">The Symmetry Anatomy of Chair Cyclohexane</h2>
        </div>
        <p class="text-xs text-slate-400 max-w-md">
          A rigid chair conformer belongs to the centrosymmetric point group <strong>D₃d</strong> (Schönflies notation). It contains 12 symmetry operations partitioned into 6 conjugacy classes.
        </p>
      </div>

      <!-- 4 High Impact Infographic Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Card 1: Principal C3 Axis -->
        <div class="glass-panel p-5 rounded-2xl border-t-4 border-t-amber-500 hover:border-amber-400 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 border border-a
